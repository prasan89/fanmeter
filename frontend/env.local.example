# Google AdSense configuration
# Set these in your actual .env.local (never commit that file) and in GCP Cloud Run env vars.

# AdSense publisher ID — format: ca-pub-XXXXXXXXXXXXXXXXX
# Leave unset to disable all ad rendering (safe for local dev and staging)
NEXT_PUBLIC_ADSENSE_CLIENT=

# Ad slot ID for the right-column sidebar unit (300x250 rectangle)
# Create this slot in your AdSense account → Ads → By ad unit → Display ads
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# ------------------------------------------------------------------
# ads.txt
# Once your site is AdSense-approved, create /public/ads.txt with:
#   google.com, ca-pub-XXXXXXXXXXXXXXXXX, DIRECT, f08c47fec0942fa0
# Replace ca-pub-XXXXXXXXXXXXXXXXX with your actual publisher ID.
# ------------------------------------------------------------------
